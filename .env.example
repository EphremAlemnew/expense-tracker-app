# Turso Serverless SQLite Credentials
# (Only needed if you want to connect to a cloud database locally, otherwise the app defaults to file:local.db)
TURSO_DATABASE_URL=your-turso-database-url
TURSO_AUTH_TOKEN=your-turso-auth-token

# Authentication Config (Falls back to 'ephrem' / 'password123' if not defined)
# Used by Backend (Express/Vercel functions):
AUTH_USERNAME=ephrem
AUTH_PASSWORD=password123

# Used by Frontend (Vite) for offline-mode login fallback validation:
# VITE_AUTH_PASSWORD_HASH must be the SHA-256 hash of your VITE_AUTH_PASSWORD
VITE_AUTH_USERNAME=ephrem
VITE_AUTH_PASSWORD_HASH=ef92b778bafe771e89245b89ecbc08a44a4e166c06659911881f383d4473e94f
